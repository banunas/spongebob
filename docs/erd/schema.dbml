// =====================================================
//  협찬 매칭 시스템 - DBML 스키마
//  팀: 협찬비빔밥
//  수정: 2026-05-17
// =====================================================

Project SponsorMatch {
  database_type: 'MariaDB'
  Note: '''
    # 협찬 매칭 시스템
    학생단체-기업 간 협찬 요청/매칭/평가를 통합 관리
  '''
}

// -----------------------------------------------------
// ENUM 정의
// -----------------------------------------------------
Enum 상태_타입 {
  PENDING   [note: '대기']
  APPROVED  [note: '승인']
  REJECTED  [note: '거절']
  DONE      [note: '완료']
  REVIEWED  [note: '후기 작성 완료']
}

Enum 작성자유형 {
  ORG      [note: '학생단체 작성']
  COMPANY  [note: '기업 작성']
}

// -----------------------------------------------------
// 1. 학생단체
// -----------------------------------------------------
Table 학생단체 {
  학생단체ID    int          [pk, increment, note: '학생단체 고유 식별자']
  단체명        varchar(50)  [not null, note: '단체 이름']
  연락처        varchar(20)  [note: '대표 연락처']

  Note: '협찬을 요청하는 학생 단체 정보'
}

// -----------------------------------------------------
// 2. 기업
// -----------------------------------------------------
Table 기업 {
  기업ID    int           [pk, increment, note: '기업 고유 식별자']
  기업명    varchar(50)   [not null, note: '기업명']
  상품명    varchar(100)  [not null, note: '협찬 가능 상품']
  연락처    varchar(20)   [note: '기업 연락처']

  Note: '''
    협찬을 제공하는 기업 정보.
    평균평점은 유도 속성으로 후기에서 동적 계산 (저장 X)
  '''
}

// -----------------------------------------------------
// 3. 행사 (학생단체가 주최)
// -----------------------------------------------------
Table 행사 {
  행사ID         int           [pk, increment, note: '행사 고유 식별자']
  행사명         varchar(100)  [not null]
  행사날짜       date
  예상참여인원   int           [note: '> 0']
  행사장소       varchar(100)
  학생단체ID     int           [not null, ref: > 학생단체.학생단체ID]

  Indexes {
    학생단체ID  [name: 'idx_행사_단체']
    행사날짜    [name: 'idx_행사_날짜']
  }

  Note: '학생단체가 주최하는 행사 (1:N 관계)'
}

// -----------------------------------------------------
// 4. 협찬요청 (행사에 포함, 기업이 수신)
// -----------------------------------------------------
Table 협찬요청 {
  협찬요청ID    int             [pk, increment, note: '협찬요청 고유 식별자']
  상태          상태_타입       [not null, default: 'PENDING']
  수량          int             [not null, note: '> 0']
  작성일시      datetime        [not null, default: `CURRENT_TIMESTAMP`]
  행사ID        int             [not null, ref: > 행사.행사ID]
  기업ID        int             [not null, ref: > 기업.기업ID]

  Indexes {
    행사ID              [name: 'idx_요청_행사']
    기업ID              [name: 'idx_요청_기업']
    상태                [name: 'idx_요청_상태']
    작성일시            [name: 'idx_요청_작성일시']
    (행사ID, 기업ID)    [unique, name: 'uq_요청_행사_기업']
  }

  Note: '''
    학생단체가 기업에게 보내는 협찬 요청.
    같은 행사에 같은 기업 중복 요청 불가 (uq_요청_행사_기업)
  '''
}

// -----------------------------------------------------
// 5. 후기 (협찬요청 1 : 후기 N)
// -----------------------------------------------------
Table 후기 {
  후기ID        int          [pk, increment, note: '후기 고유 식별자']
  평점          int          [not null, note: '1~5']
  코멘트        text
  작성일시      datetime     [not null, default: `CURRENT_TIMESTAMP`]
  작성자유형    작성자유형   [not null]
  협찬요청ID    int          [not null, ref: > 협찬요청.협찬요청ID]

  Indexes {
    (협찬요청ID, 작성자유형)  [unique, name: 'uq_후기_요청_작성자']
  }

  Note: '''
    협찬 완료(DONE) 후 양측이 작성하는 평가.
    협찬요청 1건당 ORG·COMPANY 각 1회 작성 가능 (uq_후기_요청_작성자)
    Service 레이어에서 status = DONE 검증 후 INSERT
  '''
}

// =====================================================
//  관계 명시 (보조)
// =====================================================
// 학생단체 (1) ─ 주최하다 ─ 행사      (N)
// 행사     (1) ─ 포함된다 ─ 협찬요청  (N)
// 기업     (1) ─ 수신한다 ─ 협찬요청  (N)
// 협찬요청 (1) ─ 평가한다 ─ 후기      (N)  ← 양측 각 1회 (ORG / COMPANY)
